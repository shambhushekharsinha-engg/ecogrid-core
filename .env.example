# Aegis Traffic & EcoGrid Core Environment Parameters

# Cloud PostgreSQL Database URL (Optional: Leave empty for SQLite local embedded database)
DATABASE_URL=postgresql://user:password@localhost:5432/ecogrid_db

# Web & API Ports
API_PORT=8000
SCADA_PORT=8501

# AI Model Configuration
MODEL_DIR=models/

# Google GenAI / Ollama API Tokens (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
